; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Planet Longhorn"
config/description="Planet Longhorn is a story adventure with four cognitive-task missions: Drum Circle (Corsi), Herd Rescue (Go/No-Go), Sorting Day (DCCS), and Night Watch (CPT). The game adjusts task difficulty and mission choice based on play. Profiles and performance data are stored locally on the device. The game does not diagnose or screen for conditions, and its scores are not a clinical assessment."
config/version="1.0"
run/main_scene="res://scenes/start_screen.tscn"
config/auto_accept_quit=false
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Settings="*res://scripts/settings.gd"
SceneTransition="*res://scripts/scene_transition.gd"
Metrics="*res://scripts/metrics.gd"
Music="*res://scripts/music.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
